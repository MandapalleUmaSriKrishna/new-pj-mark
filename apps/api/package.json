{
  "name": "@kdc/api",
  "version": "1.0.0",
  "private": true,
  "description": "Krishna Digital Certificate REST/JSON API - NestJS 12, MongoDB, Redis/BullMQ, PDF generation, webhooks.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npm run build --workspace @kdc/shared",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --no-warnings -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --runInBand --coverage --passWithNoTests",
    "test:e2e": "jest --runInBand --config ./test/jest-e2e.json --passWithNoTests",
    "seed": "node -r ts-node/register src/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@kdc/shared": "1.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mongodb": "7.7.0",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "papaparse": "5.7.0",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
