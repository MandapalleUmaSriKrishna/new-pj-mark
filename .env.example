# =============================================================================
# OTP Shield — environment example
# Copy to .env and fill in your own values. NEVER commit .env.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Bind to 0.0.0.0 so container platforms can route traffic to the process.
HOST=0.0.0.0

# Public origin(s) of this deployment, comma separated.
# Used to block cross-origin state-changing requests (CSRF defence).
# Example: https://otp-shield.onrender.com,https://verify.example.com
APP_ORIGIN=http://localhost:3000

# Express "trust proxy" setting. Set to 1 behind exactly one reverse proxy
# (Render, Railway, Fly, nginx, a load balancer) so rate limits see real IPs.
# Leave empty when running directly on the internet.
TRUST_PROXY=1

# Only enable if the app must render inside an iframe (preview environments).
# Keep false in production — it weakens clickjacking protection.
ALLOW_IFRAME_EMBEDDING=false

# ─── Twilio Verify (required for real SMS) ───────────────────────────────────
# Console → Account Info for the SID/token; Console → Verify → Services for the
# Verify Service SID (starts with "VA").
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RECOMMENDED: use a scoped API key pair instead of the account auth token.
# Console → Account → API keys & tokens → Create API key (Standard).
# When both values are set, the auth token above is ignored.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Timeout for calls to Twilio (ms).
TWILIO_TIMEOUT_MS=12000

# ─── Sessions ────────────────────────────────────────────────────────────────
# Required in production, 32+ characters. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECONDS=86400

# ─── OTP policy ──────────────────────────────────────────────────────────────
# Must match the code lifetime configured on your Twilio Verify Service
# (Twilio's default is 600 seconds). If they differ, the on-screen expiry timer
# will not match the real code lifetime.
OTP_TTL_SECONDS=600

# Minimum seconds between two sends to the same number (server-enforced).
OTP_RESEND_COOLDOWN_SECONDS=30

# Rolling cap per phone number, independent of Twilio's own limits.
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=3600

# Wrong-code attempts allowed per verification (Twilio caps this at 5).
OTP_MAX_VERIFY_ATTEMPTS=5

# Country preselected in the UI when the browser locale is unsupported.
OTP_DEFAULT_COUNTRY=IN

# Optional allow-list of destination countries (ISO codes, comma separated).
# Leave empty to allow every country Twilio can reach. Strongly recommended in
# production to limit SMS-pumping fraud, e.g. IN,US,GB,AE.
OTP_ALLOWED_COUNTRIES=

# ─── Rate limits (per client IP) ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_SEND_WINDOW_SECONDS=900
RATE_LIMIT_SEND_PER_IP=12
RATE_LIMIT_VERIFY_WINDOW_SECONDS=900
RATE_LIMIT_VERIFY_PER_IP=40

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
