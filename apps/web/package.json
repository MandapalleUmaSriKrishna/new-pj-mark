{
  "name": "@kdc/web",
  "version": "1.0.0",
  "private": true,
  "description": "Krishna Digital Certificate - responsive web app + installable offline-safe mobile PWA (Next.js 16, React 19, Tailwind CSS 4).",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @kdc/shared --if-present",
    "dev": "next dev -H 0.0.0.0 -p ${WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${WEB_PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:playwright": "playwright test",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "prebuild": "npm run build --workspace @kdc/shared"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@kdc/shared": "1.0.0",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "papaparse": "5.7.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
