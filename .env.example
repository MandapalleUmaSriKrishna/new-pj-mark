# ---------------------------------------------------------------------------
# Krishna Digital Certificate - environment template
# ---------------------------------------------------------------------------
# Copy to `.env` at the repository root (or export these in your orchestrator)
# and change every value marked CHANGE ME.
#
#   cp .env.example .env
#
# The API validates this file at boot with Zod (apps/api/src/config/env.ts).
# An invalid or missing value fails the process at startup with a per-key
# report rather than degrading silently.
#
# IMPORTANT - nothing here is pre-wired to a live third party. Google OAuth,
# SMTP, S3, Stripe and custom domains are all OPTIONAL. When they are not
# configured the platform says so explicitly:
#   * GET /api/v1/health  -> `capabilities` + `warnings`
#   * the affected endpoint returns 503 with a `*_not_configured` error code
#   * MAIL_DRIVER=log writes .eml files to MAIL_LOG_DIR instead of sending
# Do not present a deployment as production-ready until the sections below
# that you need are filled in.
# ---------------------------------------------------------------------------

# ============================== runtime ====================================
# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Global route prefix. Changing it changes every documented URL.
API_PREFIX=api/v1
# How long to wait for in-flight requests and workers during shutdown.
SHUTDOWN_TIMEOUT_MS=15000

# =============================== urls ======================================
# Base URL of the Next.js app (used in emails, download links and redirects).
APP_URL=http://localhost:3000
# Public base URL of this API (used for CORS, Swagger servers and signed URLs).
API_URL=http://localhost:4000
# Where the public verification page lives. Defaults to APP_URL when unset.
# Set this if verify pages are served from a different host than the dashboard.
#PUBLIC_VERIFY_BASE_URL=https://verify.example.com
# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ========================= driver selection ================================
# Every integration has a sandbox-safe fallback so the platform runs with no
# external services at all. Flip each one to its production value when the
# backing service exists.
#
#   DATA_DRIVER       mongo   | memory    (memory = data lost on restart)
#   QUEUE_DRIVER      bullmq  | memory    (memory = jobs not durable)
#   CACHE_DRIVER      redis   | memory    (memory = per-process rate limits)
#   EVENT_BUS_DRIVER  redis   | memory    (memory = realtime not shared)
#   MAIL_DRIVER       smtp    | log | disabled
#   STORAGE_DRIVER    s3      | local
DATA_DRIVER=memory
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
EVENT_BUS_DRIVER=memory
MAIL_DRIVER=log
STORAGE_DRIVER=local

# ============================== database ===================================
# Required when DATA_DRIVER=mongo. A replica set is needed for transactions;
# a standalone instance works for everything else.
MONGODB_URI=mongodb://127.0.0.1:27017/kdc
MONGODB_DB=kdc
# Pre-load demo data into the in-memory store at boot (development only).
MEMORY_STORE_SEED=false

# =============================== redis =====================================
# Required when QUEUE_DRIVER=bullmq, CACHE_DRIVER=redis or
# EVENT_BUS_DRIVER=redis. BullMQ needs Redis >= 6.2 (or Valkey >= 7.2).
REDIS_URL=redis://127.0.0.1:6379
REDIS_MAX_RETRIES=3
# Namespace for all queue keys, so several deployments can share one Redis.
QUEUE_PREFIX=kdc

# ============================== security ===================================
# CHANGE ME - all five secrets below must be unique, random and >= 32 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The defaults are development-only. In production the API logs a CRITICAL
# warning for each one you leave unchanged, and /api/v1/health reports
# status "degraded" until they are replaced.
ENCRYPTION_MASTER_KEY=dev-only-master-key-change-me-32bytes!
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32
SESSION_COOKIE_SECRET=dev-only-cookie-secret-change-me-32b
WEBHOOK_SIGNING_FALLBACK_SECRET=dev-only-webhook-secret-change-me-32

# Access tokens are short-lived; refresh tokens rotate and reuse is detected.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Set when the app and API share a parent domain (e.g. .example.com).
#COOKIE_DOMAIN=.example.com
# Defaults to true in production, false elsewhere.
COOKIE_SECURE=false
# Double-submit cookie CSRF protection for browser sessions.
CSRF_ENABLED=true

# ============================ rate limiting ================================
RATE_LIMIT_DISABLED=false
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
VERIFY_RATE_LIMIT_MAX=60
# Set true when running behind a load balancer or CDN so req.ip and Secure
# cookies are derived from X-Forwarded-* correctly (trusts exactly one hop).
TRUST_PROXY=true

# =========================== password policy ===============================
REQUIRE_STRONG_PASSWORDS=true
MIN_PASSWORD_LENGTH=10
# Passwords are hashed with argon2id using the OWASP-recommended parameters
# (19 MiB memory, t=2, p=1) and rehashed transparently on login if the
# parameters change. There is no bcrypt in this codebase.

# ============================ google oauth =================================
# OPTIONAL. Leave unset and "Sign in with Google" reports
# 503 oauth_not_configured instead of pretending to work.
#
# Create credentials at https://console.cloud.google.com/apis/credentials:
#   1. OAuth client ID -> Web application
#   2. Authorised JavaScript origins: APP_URL
#   3. Authorised redirect URI:       <API_URL>/<API_PREFIX>/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ================================= mail ====================================
# OPTIONAL. With MAIL_DRIVER=log every message is written as a .eml file to
# MAIL_LOG_DIR and its delivery row is marked "captured" (not "sent"), so the
# UI never claims an email went out when it did not.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
MAIL_FROM=Krishna Digital Certificate <no-reply@localhost>
#MAIL_REPLY_TO=support@example.com
MAIL_LOG_DIR=./data/mail
MAIL_MAX_ATTEMPTS=5

# =============================== storage ===================================
# Local driver: PDFs and uploads are written under STORAGE_LOCAL_DIR.
# Mount a persistent volume in production, or use S3.
STORAGE_LOCAL_DIR=./data/storage
# OPTIONAL S3 (or S3-compatible: MinIO, Cloudflare R2, Backblaze B2).
#S3_BUCKET=
#S3_REGION=
#S3_ENDPOINT=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=false
# Public CDN base URL for assets, when they are served outside the API.
#STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=25
# Private download links expire after this many days (0 = never).
DOWNLOAD_LINK_TTL_DAYS=30

# =============================== billing ===================================
# OPTIONAL. Default is `manual`: plan changes are applied and enforced
# immediately, are written to the audit log, and take NO payment. The API
# response says so explicitly.
#
# To charge for real, set BILLING_PROVIDER=stripe and supply both keys. The
# enterprise plan refuses to self-serve until a provider is configured.
BILLING_PROVIDER=manual
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
# Map plan ids to Stripe price ids, e.g.
# {"starter":"price_1ABC","growth":"price_2DEF"}
#STRIPE_PRICE_IDS_JSON=

# =========================== custom domains ================================
# OPTIONAL and OFF by default, because serving a tenant on their own hostname
# requires you to terminate TLS for that hostname at your proxy or CDN. This
# API does not issue TLS certificates.
#
# Enabling it lets a tenant register a hostname, prove ownership with a TXT
# record, and have the app resolve their branding from it.
CUSTOM_DOMAINS_ENABLED=false
DOMAIN_VERIFICATION_TXT_PREFIX=kdc-verify=
# OPTIONAL: token for a DNS provider API, used to automate TLS provisioning.
#DNS_PROVIDER_TOKEN=

# ============================= operations ==================================
# Swagger UI at /<API_PREFIX>/docs. In production set both credentials or
# disable it - otherwise the whole API surface is publicly browsable.
ENABLE_SWAGGER=true
#SWAGGER_USER=
#SWAGGER_PASSWORD=
ENABLE_METRICS=true
BACKUP_RETENTION_DAYS=30

# ============================ demo seed data ===============================
# Creates "Demo Organisation" with starter designs, one event and five clearly
# labelled demo certificates (recipients at the reserved example.test domain).
# Turn this OFF for any real deployment.
SEED_DEMO_DATA=false
SEED_DEMO_EMAIL=demo@kdc.local
SEED_DEMO_PASSWORD=Kdc!Sample-2026

# ============================== web app ====================================
# Consumed by scripts/dev.mjs and apps/web.
WEB_PORT=3000
# The web app talks to the API through a relative-URL proxy (next.config.ts),
# so the browser never needs to know the API host. This is the SERVER-SIDE
# target of that proxy only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
