# Dependencies and build output
node_modules
dist
.next
coverage
package-lock.json
*.tsbuildinfo

# Runtime data. ANCHORED on purpose: an unanchored `data` or `storage` also
# matches source folders (apps/api/src/infra/storage holds the object-storage
# port and its adapters), which would silently exclude real code from
# formatting - the same mistake the .gitignore used to make.
/data
/storage
/apps/*/data
/apps/*/storage
/packages/*/data

# Generated by Next.js on every dev/build start ("This file should not be
# edited"). Formatting it is undone the moment the dev server restarts.
next-env.d.ts
**/next-env.d.ts

# Reports
playwright-report
test-results

# Secrets / local config
.env
.env.*
!.env.example
