{
  "name": "Krishna Digital Certificate",
  "short_name": "KDC",
  "description": "Issue, deliver and verify tamper-evident certificates for colleges, schools, companies, NGOs, government bodies and events.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f7f9",
  "theme_color": "#1d40f0",
  "categories": ["education", "business", "productivity"],
  "lang": "en",
  "dir": "auto",
  "dir_override": "auto",
  "shortcuts": [
    {
      "name": "Issue a certificate",
      "short_name": "Issue",
      "description": "Issue a single certificate to a recipient",
      "url": "/dashboard/certificates?issue=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Verify a certificate",
      "short_name": "Verify",
      "description": "Check a certificate ID or scan a QR code",
      "url": "/verify",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Import recipients",
      "short_name": "Import",
      "description": "Bulk issue from a CSV or XLSX file",
      "url": "/dashboard/import",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
